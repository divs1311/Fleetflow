# Copy to .env and adjust. docker compose reads this file automatically.

# Linux only: run containers as your user so files under ./data are yours (`id -u`).
AIRFLOW_UID=50000

# Simulation and backfill window (the DAG catches up START .. START + DAYS - 1 on first start)
PORTERFLOW_START_DATE=2026-09-01
PORTERFLOW_BACKFILL_DAYS=14
SIM_TRIPS_PER_DAY=20000
SIM_SEED=42

# Cloud export of the gold tables: s3 (MinIO locally) or none
PORTERFLOW_EXPORT_TARGET=s3

# Local-only credentials (change them if you expose any port beyond localhost)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
MASTER_API_KEY=porterflow-dev-key
MINIO_ROOT_USER=porterflow
MINIO_ROOT_PASSWORD=porterflow-secret
